{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "laravel",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PHP_CLI_SERVER_WORKERS=8",
        "APP_URL=http://localhost:8001",
        "php",
        "artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8001"
      ],
      "port": 8001
    },
    {
      "name": "laravel-phone",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PHP_CLI_SERVER_WORKERS=8",
        "APP_URL=http://192.168.1.5:8002",
        "php",
        "artisan",
        "serve",
        "--host=0.0.0.0",
        "--port=8002"
      ],
      "port": 8002
    }
  ]
}