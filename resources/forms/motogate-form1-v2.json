{
  "sections": [
    {
      "key": "work",
      "items": [
        {
          "data": {
            "key": "work",
            "label": "الحالة الوظيفية لصاحب الطلب",
            "binding": "work.status",
            "options": [
              {
                "label": "موظف حكومي",
                "value": "government",
                "customer_type_id": 1
              },
              {
                "label": "موظف قطاع خاص متأمن عليه",
                "value": "employee",
                "customer_type_id": 1
              },
              {
                "label": "موظف قطاع خاص مش متأمن عليه — دخل حر",
                "value": "private_uninsured",
                "customer_type_id": 2,
                "work_types": [
                  "other"
                ]
              },
              {
                "label": "عربيات نقل ذكي / شغل بعربية",
                "value": "smart_transport",
                "customer_type_id": 2,
                "work_types": [
                  "delivery_app",
                  "delivery_company"
                ]
              },
              {
                "label": "دليفري على موتوسيكل / دراجة (طلبات ونحوه)",
                "value": "delivery",
                "work_types": [
                  "delivery_app",
                  "delivery_app_bicycle",
                  "delivery_company"
                ],
                "customer_type_id": 2
              },
              {
                "label": "شغل حر / صنايعي / باليومية",
                "value": "free",
                "work_types": [
                  "craftsman",
                  "other",
                  "none"
                ],
                "customer_type_id": 2
              },
              {
                "label": "صاحب محل / ورشة / نشاط",
                "value": "business",
                "customer_type_id": 4
              },
              {
                "label": "على المعاش",
                "value": "pension",
                "customer_type_id": 3
              }
            ],
            "required": true
          },
          "type": "radio"
        },
        {
          "data": {
            "key": "job_title",
            "label": "الوظيفة / الشغلانة بالظبط",
            "required": true,
            "conditions": [
              {
                "field": "work",
                "value": "employee,free,business,government,private_uninsured,smart_transport",
                "operator": "in"
              }
            ]
          },
          "type": "text"
        },
        {
          "data": {
            "key": "place_name",
            "label": "اسم جهة العمل / الشركة / النشاط",
            "binding": "work.place_name",
            "required": true,
            "conditions": [
              {
                "field": "work",
                "value": "employee,business,government,private_uninsured,smart_transport",
                "operator": "in"
              }
            ],
            "help": "اسم جهة العمل أو النشاط. لو شغال بعربيتك لحسابك، اكتب وصف شغلك الفعلي مثل شغل بعربيتي."
